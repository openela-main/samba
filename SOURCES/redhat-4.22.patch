 		result = openat2(dirfd,
 				 smb_fname->base_name,
@@ -681,10 +691,13 @@ static int vfswrap_openat(vfs_handle_struct *handle,
 				 * openat2(), so indicate to
 				 * the callers that
 				 * VFS_OPEN_HOW_RESOLVE_NO_SYMLINKS
