 				 * would just be a waste of time.
 				 */
 				fsp->conn->open_how_resolve &=
 					~VFS_OPEN_HOW_RESOLVE_NO_SYMLINKS;
+				fsp->conn->open_how_resolve &=
+					~VFS_OPEN_HOW_RESOLVE_NO_XDEV;
 			}
 			goto out;
 		}
