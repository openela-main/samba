+	const char *fname1 = BASEDIR "\\test_open_brlock_deadlock1.txt";
+	const char *fname2 = BASEDIR "\\test_open_brlock_deadlock2.txt";
+	struct open_brlock_deadlock_state state;
+	struct smb2_handle h = {};
+	uint8_t buf[200];
+	struct tevent_timer *te = NULL;
+	NTSTATUS status;
+	bool ret = true;
